{
  "schemaVersion": 1,
  "id": "meteor-zcore",
  "version": "${version}",
  "name": "MeteorZCore",
  "description": "MeteorZCore addon for Meteor Client.",
  "authors": [
    "EasonZYQ"
  ],
  "contact": {
    "sources": "https://github.com/EasonZYQ/MeteorZCore"
  },
  "icon": "assets/zcore/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.eason.zcore.MeteorZCore"
    ]
  },
  "mixins": [
    "zcore.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
